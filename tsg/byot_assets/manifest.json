{
  "project": "TSG",
  "module": "BYOT",
  "name": "Build Your Own Trans-Sign",
  "asset_files": {
    "prefixes": "prefixes.json",
    "suffixes": "suffixes.json",
    "words": "words.json"
  },
  "tray_sizes": {
    "prefixes": 8,
    "words": 8,
    "suffixes": 8
  },
  "selection_rules": {
    "prefixes": "zero_or_more",
    "words": "exactly_one",
    "suffixes": "zero_or_more",
    "minimum_total_pieces": 2
  },
  "composition_rules": {
    "selected_items_are_numbered": true,
    "order_is_defined_by_sequence": true,
    "repetition_is_defined_by_repeating_numbers": true,
    "join_modes": [
      "glued",
      "hyphenated"
    ],
    "default_join_mode": "glued"
  },
  "word_pool": {
    "source": "palavras_tsg_completo_corrigido_2.tsv",
    "top_frequency_limit": 5000,
    "pos_weights": {
      "n": 0.35,
      "v": 0.2,
      "aj": 0.2,
      "av": 0.08,
      "pn": 0.08,
      "num": 0.02,
      "cj": 0.02,
      "prp": 0.02,
      "at": 0.02,
      "i": 0.01
    },
    "default_word_weight": 0.01
  },
  "counts": {
    "prefixes": 127,
    "suffixes": 97,
    "words": 5000
  }
}